# MangaFlow 后端环境变量模板（文件级说明）。
#
# 使用方式：复制本文件为 backend/.env（pydantic-settings 自动读取，env_file=".env"，
# 相对启动目录 cwd=backend 解析），或以同名大写环境变量注入容器/进程。
# 安全基线（D1）：任何真实密钥不得写入代码仓库；本文件仅为占位模板，密钥一律
# 使用 your-key-here 占位，上线前替换为线下分发的真实值。
# 注意：列表类型变量（如 CORS_ORIGINS）使用 JSON 数组格式。

# ==================== 数据库 ====================
# 业务库连接串（PostgreSQL + asyncpg 异步驱动）；密码占位请替换
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/mangaflow
# 管理库连接串（连 postgres 系统库，仅用于启动时自动创建 mangaflow 业务库）
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/postgres

# ==================== 认证 / JWT ====================
# JWT 签名密钥（生产环境务必更换为高强度随机串）
JWT_SECRET_KEY=your-jwt-secret-here
# JWT 签名算法
JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================== 模型渠道密钥（5 个渠道） ====================
# 未配置的渠道不阻断启动：对应能力沿降级链走本地 mock 演示占位（产物带
# placeholder 标记并免计费），启动日志会出现"未配置 API Key"告警。

# ---- DeepSeek 文本 LLM（主渠道） ----
# DeepSeek 兼容 OpenAI 协议的 API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek API Key（线下获取后替换占位符）
DEEPSEEK_API_KEY=your-key-here
# 默认文本大模型名称
DEEPSEEK_MODEL=deepseek-chat

# ---- Agnes 文本 LLM（兜底渠道） ----
# Agnes 文本 LLM 兼容 OpenAI 协议的 API 地址
AGNES_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# Agnes 文本 LLM API Key
AGNES_LLM_API_KEY=your-key-here
# Agnes 文本 LLM 默认模型名
AGNES_LLM_MODEL=agnes-3.0-flash

# ---- Agnes 图像生成 ----
# Agnes 图像生成兼容 OpenAI 协议的 API 地址
AGNES_IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
# Agnes 图像生成 API Key
AGNES_IMAGE_API_KEY=your-key-here
# Agnes 图像生成默认模型名
AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# ---- Agnes 视频生成 ----
# Agnes 视频生成兼容 OpenAI 协议的 API 地址
AGNES_VIDEO_BASE_URL=https://apihub.agnes-ai.com/v1
# Agnes 视频生成 API Key
AGNES_VIDEO_API_KEY=your-key-here
# Agnes 视频生成默认模型名
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
# 视频生成模式（官方枚举 text/keyframe/reference；带首帧图时 provider 自动切 keyframe）
AGNES_VIDEO_MODE=text
# 视觉机审模型名（图像/视频产物真实视觉机审，OpenAI 兼容图文混合协议）
AGNES_VISION_MODEL=agnes-3.0-flash-max

# ---- 阿里云百炼 TTS / 图生视频 ----
# 百炼 TTS 兼容 OpenAI 协议的 API 地址（WebSocket 网关）
BAILIAN_TTS_BASE_URL=https://your-instance.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 百炼 API Key（TTS 与 wan 图生视频渠道共用）
BAILIAN_TTS_API_KEY=your-key-here
# 百炼 TTS 默认模型名
BAILIAN_TTS_MODEL=qwen-audio-3.1-tts-flash
# 百炼视频（wan2.7-i2v）原生协议根域名（非 OpenAI 兼容 /compatible-mode）
BAILIAN_WAN_BASE_URL=https://your-instance.cn-beijing.maas.aliyuncs.com
# 百炼图生视频模型名
BAILIAN_WAN_MODEL=wan2.7-i2v

# ==================== 异步视频轮询 ====================
# 异步视频生成任务轮询间隔（秒）
VIDEO_POLL_INTERVAL_SECONDS=5
# 异步视频生成任务轮询总超时（秒）
VIDEO_POLL_TIMEOUT_SECONDS=300

# ==================== 安全与存储 ====================
# 模型渠道 API Key 的 AES 加密密钥（须为 16/24/32 字节字符串；生产环境务必更换）
AES_KEY=your-aes-key-32-bytes-long-string!
# 本地文件存储根目录（相对路径以项目根目录为基准拼接）
STORAGE_DIR=backend/storage
# 允许跨域的来源列表（JSON 数组格式，"*" 表示不限制）
CORS_ORIGINS=["*"]
# 画布插件 endpoint_url 信任域白名单（JSON 数组；空 = 不限公网域名，仅强制内网黑名单）
PLUGIN_ALLOWED_HOSTS=[]

# ==================== 业务开关 ====================
# 违规分级处罚准入校验（产品上线后置 true 启用拦截）
PUNISHMENT_ENABLED=false
# 启动时是否先执行 Alembic 迁移（alembic upgrade head）再走 create_all 兜底
ALEMBIC_ON_STARTUP=false

# ==================== LangSmith 追踪 ====================
# 是否启用 LangSmith 链路追踪（true/1 启用；默认关闭零开销）
LANGSMITH_TRACING=false
# LangSmith API Key（lsv2_ 前缀；启用追踪时必填）
LANGSMITH_API_KEY=
# trace 上报的目标 LangSmith 项目名
LANGSMITH_PROJECT=mangaflow
