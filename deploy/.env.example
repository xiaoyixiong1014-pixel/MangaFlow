# =============================================================================
# 漫序 MangaFlow 部署环境变量模板（文件级说明）
#
# 用法   : cd deploy && cp .env.example .env，再按需修改
# 加载方 : docker compose 启动时自动读取同目录 .env 做变量插值
# 安全   : 生产环境必须替换全部默认密码/密钥；.env 含敏感信息，切勿提交仓库
# =============================================================================

# ============================== PostgreSQL ==============================
# 超级用户名（容器初始化时创建；backend 以该用户连接）
POSTGRES_USER=postgres
# 超级用户密码（默认 123456 仅为本地演示；生产请改为强密码，
# 注意：密码避免包含 @ / : # 等特殊字符，否则需在连接串中做 URL 编码）
POSTGRES_PASSWORD=123456
# 业务库名
POSTGRES_DB=mangaflow

# ---- 连接串（一般无需手填，compose 会按 POSTGRES_* 自动拼串）----
# DATABASE_URL        : 业务库连接串（asyncpg 异步驱动），容器内主机名固定为 postgres
# ADMIN_DATABASE_URL  : 管理库连接串（连 postgres 系统库，用于自动创建业务库）
# 如需覆盖整串，取消注释并保持密码与 POSTGRES_PASSWORD 一致：
# DATABASE_URL=postgresql+asyncpg://postgres:123456@postgres:5432/mangaflow
# ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:123456@postgres:5432/postgres

# ============================== JWT 认证 ==============================
# JWT 签名密钥（生产请替换：openssl rand -hex 32 生成）
JWT_SECRET_KEY=mangaflow-dev-jwt-secret-change-me-in-production
# JWT 签名算法
JWT_ALGORITHM=HS256

# ====================== 模型渠道 Key 加密（AES） ======================
# 模型渠道 API Key 落库加密密钥（须为 16/24/32 字节字符串；
# 生产请替换：openssl rand -hex 16 生成 32 字符十六进制串）
AES_KEY=mangaflow-aes-key-1234567890abcd

# ============================== 构建加速 ==============================
# npm 镜像源（Dockerfile 可配置 ARG，默认官方源；
# 国内构建推荐：https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org
# pip 镜像源（backend.Dockerfile 可配置 ARG，默认官方源；
# 国内构建推荐：https://pypi.tuna.tsinghua.edu.cn/simple）
PIP_INDEX_URL=https://pypi.org/simple

# ============================== 镜像标签 ==============================
# 自建镜像 tag（保留默认 latest 即可；发布时可设为时间戳便于回滚）
IMAGE_TAG=latest
