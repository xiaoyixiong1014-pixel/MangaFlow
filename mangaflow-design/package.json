{
  "name": "@mangaflow/design",
  "version": "0.1.0",
  "description": "漫序 MangaFlow 共享设计系统：设计 token（墨青/藤紫双引擎色板）、主题切换与基础组件。mangaflow-web 与 mangaflow-admin-web 共用的 UI 单一事实源（RD-58）。",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "keywords": ["mangaflow", "design-system", "tokens", "vue3"],
  "main": "./dist/mangaflow-design.js",
  "module": "./dist/mangaflow-design.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mangaflow-design.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts"
    },
    "./styles.css": "./dist/mangaflow-design.css",
    "./element-plus.css": "./dist/element-plus-bridge.css",
    "./compat.css": "./dist/compat.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-bridge.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
