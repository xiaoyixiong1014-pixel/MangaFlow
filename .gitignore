# MangaFlow 根 .gitignore（D1 密钥治理配套：本地密钥文件绝不进仓库）

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.log

# ---- 运行产物 ----
backend/storage/

# ---- 前端（各子项目自带 .gitignore，此处兜底） ----
node_modules/
dist/

# ---- 设计系统内部仓库备份（避免主仓库误识别为 submodule 的历史保留） ----
mangaflow-design/.git.bak/
